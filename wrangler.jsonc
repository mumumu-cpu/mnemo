{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mnemo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mnemo-db",
      "database_id": "248992b5-a7a6-46ce-98ae-f5c6435b5350",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "5cfa7ee74c0143cb8529a8ce50d08efa" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "GOOGLE_CLIENT_ID": "267962789836-utksmf06oed6ougubbl2n58js3iagu1c.apps.googleusercontent.com"
  }
}
